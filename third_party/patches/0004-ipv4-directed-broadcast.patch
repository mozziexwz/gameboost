@@ -504,5 +504,5 @@
 }
 
-BOOL is_broadcast_or_multicast(UINT32 ip)
+BOOL is_broadcast_or_multicast(UINT32 ip, UINT32 src_ip, UINT32 interface_index)
 {
     // note: Localhost (127.x.x.x) is now supported for proxying
@@ -520,12 +520,23 @@
         return TRUE;
 
-    // x.x.x.255
-    if ((ip & 0xFF000000) == 0xFF000000)
-        return TRUE;
-
     // Multicast: 224.0.0.0 - 239.255.255.255 (first octet 224-239)
     if (first_octet >= 224 && first_octet <= 239)
         return TRUE;
 
-    return FALSE;
+    // A directed broadcast uses the sender's on-link prefix. All eligible
+    // prefixes leave at least two host bits; /31 and /32 have no broadcast.
+    const UINT32 dst = ntohl(ip);
+    if ((dst & 3) != 3 || interface_index == 0)
+        return FALSE;
+
+    MIB_UNICASTIPADDRESS_ROW source = {0};
+    source.Address.Ipv4.sin_family = AF_INET;
+    source.Address.Ipv4.sin_addr.s_addr = src_ip;
+    source.InterfaceIndex = interface_index;
+    if (GetUnicastIpAddressEntry(&source) != NO_ERROR ||
+        source.OnLinkPrefixLength == 0 || source.OnLinkPrefixLength >= 31)
+        return FALSE;
+
+    const UINT32 host_bits = (1u << (32 - source.OnLinkPrefixLength)) - 1u;
+    return dst == (ntohl(src_ip) | host_bits);
 }
